# Storyteq API (Creative Automation v4)
# Kopieer naar .env.local en vul in. .env.local staat in .gitignore.

# Persoonlijke bearer-token van een ACT-medewerker.
# Nooit committen, nooit in client-code, nooit in logs.
STORYTEQ_API_KEY=

# europe-west1 (default) of us-east4
STORYTEQ_REGION=europe-west1

# Optioneel. Komt niet voor in de v4-spec; alleen invullen als discovery
# uitwijst dat de API er iets mee doet. Zie docs/api-discovery.md.
STORYTEQ_COMPANY_ID=

# Optioneel: overschrijft de base URL (default https://api.${REGION}.storyteq.com/v4)
STORYTEQ_BASE_URL=

# Schrijft elke proxy-call naar docs/discovery/log.jsonl (auth geredact).
# Staat in development altijd aan; zet op 1 om ook in productie te loggen.
STORYTEQ_DISCOVERY_LOG=
