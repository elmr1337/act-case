# Storyteq API (Creative Automation v4)
# Kopieer naar .env.local en vul in. .env.local staat in .gitignore.

# Persoonlijke bearer-token van een ACT-medewerker.
# Nooit committen, nooit in client-code, nooit in logs.
STORYTEQ_API_KEY=

# europe-west1 (default) of us-east4
STORYTEQ_REGION=europe-west1

# VERPLICHT als de token toegang heeft tot meerdere companies — en dat is bij
# een persoonlijke medewerkers-token meestal zo. Zonder deze waarde antwoordt
# Storyteq met 403 "This user has access to multiple companies".
# Staat niet in de OpenAPI-spec; zie docs/api-discovery.md §2.
STORYTEQ_COMPANY_ID=

# Optioneel: overschrijft de base URL (default https://api.${REGION}.storyteq.com/v4)
STORYTEQ_BASE_URL=

# Schrijft elke proxy-call naar docs/discovery/log.jsonl (auth en company-id
# geredact). Staat in development altijd aan; zet op 1 om ook in productie te
# loggen. `npm run explore` zet hem sowieso aan.
STORYTEQ_DISCOVERY_LOG=

# --- Optioneel: persistente joblijst ---------------------------------------
# Zonder REDIS_URL leeft "jouw assets" alleen in localStorage van deze browser.
# Met REDIS_URL bewaart de server hem er ook, onder een anonieme sessie-cookie:
# je overzicht overleeft dan het legen van je browseropslag.
# Er staat geen render-inhoud in, alleen media-id's en een label.
# Voorbeeld: redis://localhost:6379
REDIS_URL=
