# Kopieer naar opdracht-1/.env (één niveau hoger, waar de worker draait):
#   cp worker/.env.example .env

# Drivers (defaults: alles lokaal, nul infra)
QUEUE_DRIVER=memory        # memory | redis
STORE_DRIVER=local         # local | s3
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Alleen nodig bij QUEUE_DRIVER=redis
REDIS_URL=

# Alleen nodig bij STORE_DRIVER=s3 (Hetzner Object Storage)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Providers
FAL_API_KEY=
GEMINI_API_KEY=

# Cost config (prijs per image voor providers zonder cost in response)
GEMINI_IMAGE_COST_USD=0.134   # Nano Banana Pro, per gegenereerd beeld (schatting, check actuele prijs)
FAL_IMAGE_COST_USD=0.025      # Flux dev per beeld ~1MP (schatting, check fal dashboard)
FAL_TRAIN_COST_USD=2.00       # per 1000 trainingssteps (schatting, check fal dashboard)

# Optioneel
ANTHROPIC_API_KEY=            # als analyze via Claude loopt (ANALYZE_PROVIDER=anthropic)

# --- Geavanceerd (defaults zijn prima) --------------------------------------
# ANALYZE_PROVIDER=gemini             # gemini | anthropic
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_ANALYZE_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-3-pro-image   # Nano Banana Pro; alternatief: gemini-2.5-flash-image
# FAL_FLUX_MODEL=fal-ai/flux/dev
# FAL_LORA_MODEL=fal-ai/flux-lora
# FAL_TRAIN_MODEL=fal-ai/flux-lora-fast-training
# TRIGGER_PHRASE=ACTCAMP style
# TRAIN_STEPS=1000
# LUT_PATH=lut/campaign.cube
# WORKER_CONCURRENCY=3
# IMAGE_SIZE=portrait_4_3             # fal image_size enum
# IMAGE_ASPECT=3:4                    # gemini aspectRatio
# GEMINI_IN_COST_PER_MTOK=0.30
# GEMINI_OUT_COST_PER_MTOK=2.50
# ANTHROPIC_IN_COST_PER_MTOK=5.00
# ANTHROPIC_OUT_COST_PER_MTOK=25.00
